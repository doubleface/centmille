{
  "name": "centmille",
  "version": "1.0.0",
  "description": "Feuille de marque mobile pour le jeu 10 000 avec gestion des règles et scores",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "share": "npm run build && (npx vite preview --host 127.0.0.1 --port 4173 --strictPort & ssh -o StrictHostKeyChecking=accept-new -R 80:127.0.0.1:4173 nokey@localhost.run; kill 0)",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "keywords": [
    "dixmille",
    "jeu",
    "des",
    "score"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^29.1.1",
    "vite": "^7.1.12",
    "vitest": "^4.1.5"
  }
}
